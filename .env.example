# Template Konfigurasi Lingkungan Proyek Automation Sales Flow

# ==========================================
# 1. Supabase Backend (Shared)
# ==========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
# Service Role Key HANYA untuk backend / Supabase Edge Functions (JANGAN taruh di frontend client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# 2. Frontend Internal App (React / Vite)
# ==========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ==========================================
# 3. Public Website (Next.js - Phase 1B)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
